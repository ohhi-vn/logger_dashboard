<Layouts.app flash={@flash} active={:home}>
  <div class="space-y-2">
    <h1 class="text-2xl font-bold tracking-tight">Log Dashboard</h1>
    <p class="text-sm text-base-content/70">
      Browse, analyze, and prune logs shipped to ClickHouse by your nodes.
    </p>
  </div>

  <div id="home-tools" class="grid gap-4 sm:grid-cols-3">
    <.link
      id="home-card-logs"
      navigate={~p"/logs"}
      class="group flex flex-col gap-2 rounded-xl border border-base-300 bg-base-100 p-5 transition hover:border-primary hover:shadow-sm"
    >
      <span class="flex items-center gap-2 font-semibold">
        <.icon name="hero-document-text" class="size-5 text-primary" /> Logs
      </span>
      <span class="text-sm text-base-content/70">
        Search and page through raw log rows, newest first.
      </span>
    </.link>

    <.link
      id="home-card-analysis"
      navigate={~p"/analysis"}
      class="group flex flex-col gap-2 rounded-xl border border-base-300 bg-base-100 p-5 transition hover:border-primary hover:shadow-sm"
    >
      <span class="flex items-center gap-2 font-semibold">
        <.icon name="hero-chart-bar-square" class="size-5 text-primary" /> Analysis
      </span>
      <span class="text-sm text-base-content/70">
        Volume, level mix, and per-node breakdown for a scope and time range.
      </span>
    </.link>

    <.link
      id="home-card-prune"
      navigate={~p"/prune"}
      class="group flex flex-col gap-2 rounded-xl border border-base-300 bg-base-100 p-5 transition hover:border-primary hover:shadow-sm"
    >
      <span class="flex items-center gap-2 font-semibold">
        <.icon name="hero-trash" class="size-5 text-primary" /> Prune
      </span>
      <span class="text-sm text-base-content/70">
        Delete old rows for one node or the whole system, with confirmation.
      </span>
    </.link>
  </div>
</Layouts.app>
