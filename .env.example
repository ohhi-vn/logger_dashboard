# Copy to .env and fill in the three required secrets. `podman compose up`
# reads this file automatically and aborts if a required value is missing.
# Keep it out of version control: `chmod 600 .env`.

# --- Required ---

# Signs session cookies. Generate with:
#   mix phx.gen.secret
SECRET_KEY_BASE=

# Shared token for every route. Anyone holding it can prune logs, so keep it
# out of shell history. Generate with:
#   mix logger_dashboard.gen.token
# Required by the stack even though the app falls back to an ephemeral token
# on its own: that fallback rotates on every restart and is only recoverable
# from container logs, which breaks anything scripted against the stack.
DASHBOARD_AUTH_TOKEN=

# Password for ClickHouse's `default` user. Generate a high-entropy value, e.g.
#   openssl rand -hex 24
# The dashboard reaches ClickHouse with this password embedded in the URL's
# userinfo (http://default:<password>@clickhouse:8123), because the ClickHouse
# client is not given a separate username/password. Keep the value free of
# `/ : @ ? # & %` and whitespace so the URL stays well-formed; hex output has
# none of them.
CLICKHOUSE_PASSWORD=

# --- Optional (defaults shown) ---

# Host used for generated URLs. Also decides whether the prod force_ssl
# redirect applies: it exempts only `localhost` and `127.0.0.1`, so any other
# value needs TLS terminated in front of the published port.
PHX_HOST=localhost

# ClickHouse database holding the `logs` table. Created by the server service
# on first boot and by the startup DDL step.
CLICKHOUSE_DATABASE=logger_dashboard

# Host port the dashboard is published on (loopback only).
DASHBOARD_PORT=4000